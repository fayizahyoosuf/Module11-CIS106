<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Discount Calculator"/>
        <attribute name="authors" value="Student"/>
        <attribute name="about" value="Computes discount amount and discounted price using a function."/>
        <attribute name="saved" value="2026-11-18 09:04:40 PM"/>
        <attribute name="created" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTEtMTg7MDk6MDI6MDUgUE07MjkzMg=="/>
        <attribute name="edited" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTEtMTg7MDk6MDQ6NDAgUE07MTszMDQx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="quantity" type="Integer" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="discountRate" type="Real" array="False" size=""/>
            <declare name="discountAmount" type="Real" array="False" size=""/>
            <declare name="discountedPrice" type="Real" array="False" size=""/>
            <declare name="results" type="Real" array="True" size="2"/>
            <output expression="&quot;Enter the quantity:&quot;" newline="True"/>
            <input variable="quantity"/>
            <output expression="&quot;Enter the unit price:&quot;" newline="True"/>
            <input variable="price"/>
            <output expression="&quot;Enter the discount rate (e.g. 0.10 for 10%):&quot;" newline="True"/>
            <input variable="discountRate"/>
            <call expression="computeDiscount(quantity, price, discountRate, results)"/>
            <assign variable="discountAmount" expression="results[0]"/>
            <assign variable="discountedPrice" expression="results[1]"/>
            <output expression="&quot;Quantity: &quot; &amp; quantity" newline="True"/>
            <output expression="&quot;Unit Price: $&quot; &amp; ToFixed(price, 2)" newline="True"/>
            <output expression="&quot;Discount Amount: $&quot; &amp; ToFixed(discountAmount, 2)" newline="True"/>
            <output expression="&quot;Discounted Price: $&quot; &amp; ToFixed(discountedPrice, 2)" newline="True"/>
        </body>
    </function>
    <function name="computeDiscount" type="None" variable="">
        <parameters>
            <parameter name="qty" type="Integer" array="False"/>
            <parameter name="unitPrice" type="Real" array="False"/>
            <parameter name="rate" type="Real" array="False"/>
            <parameter name="returnValues" type="Real" array="True"/>
        </parameters>
        <body>
            <declare name="extendedPrice" type="Real" array="False" size=""/>
            <assign variable="extendedPrice" expression="qty * unitPrice"/>
            <assign variable="returnValues[0]" expression="extendedPrice * rate"/>
            <assign variable="returnValues[1]" expression="extendedPrice - returnValues[0]"/>
        </body>
    </function>
</flowgorithm>
